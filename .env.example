# Copia este archivo a .env y completa los valores reales.
# Ver README.md para instrucciones paso a paso de cómo obtener cada credencial.

# --- Twilio WhatsApp Sandbox ---
# Consola: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del sandbox de Twilio, en formato whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Anthropic (Claude Haiku) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Sheets (Service Account) ---
# Ruta al JSON descargado de Google Cloud (ver README.md).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# ID del Google Sheet (lo encuentras en la URL del Sheet).
GOOGLE_SHEET_ID=

# --- Opcionales (tienen valores por defecto razonables) ---
# Tamaño del modelo de faster-whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base
# Modelo de Anthropic a usar para interpretar la consulta del cliente.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Modelo de moto al que pertenece TODO el catálogo del Sheet (la muestra está acotada a una sola
# referencia). El bot usa esto para avisar cuando el cliente pregunta por una moto distinta, en vez
# de confirmar un repuesto que coincide de nombre pero es de otra moto.
CATALOG_MOTO_MODEL=Suzuki GN 125
